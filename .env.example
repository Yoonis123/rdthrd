# Copy this file to ".env.local" and paste your real key after the = sign.
# Get a key at https://console.cloud.google.com/google/maps-apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud (Map Management). Leave blank to use Google's demo map ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
